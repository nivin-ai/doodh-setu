# Gnani.ai (Vachana) API key. Get one from https://app.gnani.ai/voice
# Leave empty to use the browser's built-in voice instead.
GNANI_API_KEY=

# AI answers in the Ask tab. Set ONE of these (Gemini has a free tier: https://aistudio.google.com/apikey).
# Leave both empty to use the fixed, rule-based answers instead.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Map tiles for the demand map. Free key from https://carto.com/basemaps/apikey/
# Leave empty to use plain OpenStreetMap tiles instead.
CART_KEY=

# Database for DairyFin consent and loan records (optional). Create a free Supabase project,
# run supabase/schema.sql in its SQL Editor, then copy these from Project Settings > API.
# The service role key is secret: server only, never in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
