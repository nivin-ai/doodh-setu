# Gnani.ai (Vachana) API key. Get one from https://app.gnani.ai/voice
# Leave empty to use the browser's built-in voice instead.
GNANI_API_KEY=

# AI answers in the Ask tab (Claude Haiku). Get a key at https://console.anthropic.com
# Leave empty to use the fixed, rule-based answers instead.
ANTHROPIC_API_KEY=

# Map tiles for the demand map. Free key from https://carto.com/basemaps/apikey/
# Leave empty to use plain OpenStreetMap tiles instead.
CART_KEY=

# Database (Supabase Postgres). Transaction pooler connection string from Project Settings > Database.
# Secret: server only. Leave empty to use the local demo database (PGlite, resets on restart).
# Set up the schema and demo data with supabase/README.md.
DATABASE_URL=
# Set to false to disable the public "Reset demo" button
ALLOW_DEMO_RESET=

# Signs the staff console sign-in cookie. Set any long random string in Vercel.
AUTH_SECRET=
